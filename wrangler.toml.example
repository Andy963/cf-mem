name = "cf-rag"
main = "src/index.ts"
compatibility_date = "2026-03-03"
workers_dev = true
preview_urls = true

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "cf-text"
database_id = "<YOUR_D1_DATABASE_ID>"

[[vectorize]]
binding = "SEGMENTS_INDEX"
index_name = "cf-vector"

[[vectorize]]
binding = "CLAIMS_INDEX"
index_name = "cf-claims"

# Optional: bind a custom domain route (uncomment and edit).
#
# [[routes]]
# pattern = "emb.example.com/*"
# zone_name = "example.com"

[vars]
CORS_ALLOW_ORIGIN = "*"
# The /admin dashboard requires Cloudflare Access plus this allowed email.
# Set workers_dev = false in production so the dashboard cannot bypass Access
# through the worker's workers.dev address.
# ADMIN_ALLOWED_EMAIL = "you@example.com"
EMBEDDING_MODEL = "@cf/baai/bge-m3"
RERANK_MODEL = "@cf/baai/bge-reranker-base"
# Optional: set to true to enable rerank by default for /memory/search.
# RERANK_DEFAULT_ENABLED = "true"
# Profile extractor: prefer PROFILE_EXTRACTOR_ENDPOINT. OPENROUTER_API_BASE is
# accepted as a fallback when the dedicated endpoint var is unset.
# PROFILE_EXTRACTOR_ENDPOINT = "https://openrouter.ai/api/v1"
# PROFILE_EXTRACTOR_MODEL = "your-openrouter-model"
# PROFILE_EXTRACTOR_PROTOCOL = "chat_completions"
# OPENROUTER_API_BASE = "https://openrouter.ai/api/v1"
# OpenRouter app attribution (optional): the URL is sent as HTTP-Referer and is
# the identity OpenRouter groups activity by; the title is sent as
# X-OpenRouter-Title and only names that app. A title without a URL stays
# attributed to "unknown".
# PROFILE_EXTRACTOR_APP_URL = "https://github.com/Andy963/cf-rag"
# PROFILE_EXTRACTOR_APP_TITLE = "cf-rag"
# Claim semantic deduplication. The claim metadata indexes should be created
# before using filtered semantic deduplication.
CLAIM_DEDUP_SAME_SCORE = "0.92"
CLAIM_DEDUP_REVIEW_MIN_SCORE = "0.75"
CLAIM_DEDUP_TOP_K = "12"
CLAIM_DEDUP_LLM_ENABLED = "true"
CLAIM_DEDUP_AUTO_REPLACE = "false"
# /memory/* requires a PROJECT_TOKENS_JSON secret such as:
# {"proj-a":"token-for-a","proj-b":"token-for-b"}
# Profile extractor also needs secrets:
#   PROFILE_EXTRACTOR_API_KEY
#   PROFILE_EXTRACTOR_ENDPOINT  (optional if OPENROUTER_API_BASE is set)
# Web extraction via the Tavily relay also needs secrets:
#   TAVILY_API_TOKEN  (the tavily-worker ingress token)
#   TAVILY_BASE_URL   (for example https://tavily.example.com)

[triggers]
crons = ["*/5 * * * *"]
