name = "cf-mem"
main = "src/index.ts"
compatibility_date = "2026-03-03"
workers_dev = true
preview_urls = true

[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "cf-text"
database_id = "<YOUR_D1_DATABASE_ID>"

[[vectorize]]
binding = "SEGMENTS_INDEX"
index_name = "cf-vector"

[[vectorize]]
binding = "CLAIMS_INDEX"
index_name = "cf-claims"

# Optional: bind a custom domain route (uncomment and edit).
#
# [[routes]]
# pattern = "mem.example.com/*"
# zone_name = "example.com"

[vars]
CORS_ALLOW_ORIGIN = "*"
# Optional allowlist for explicit memory project headers.
# ALLOWED_MEMORY_PROJECTS = "personal,whisper,ads,cf-mem,study_copilot"
# The /admin dashboard requires Cloudflare Access plus this allowed email.
# Set workers_dev = false in production so the dashboard cannot bypass Access
# through the worker's workers.dev address.
# ADMIN_ALLOWED_EMAIL = "you@example.com"
EMBEDDING_MODEL = "@cf/baai/bge-m3"
RERANK_MODEL = "@cf/baai/bge-reranker-base"
# Optional: set to true to enable rerank by default for /memory/search.
# RERANK_DEFAULT_ENABLED = "true"
# Extractor LLM: the endpoint must expose an OpenAI-compatible API.
# These are optional until /memory/profile/ingest is enabled.
# EXTRACTOR_LLM_API_BASE = "https://your-openai-compatible-endpoint/v1"
# EXTRACTOR_LLM_MODEL = "your-model"
# PROFILE_EXTRACTOR_PROTOCOL = "chat_completions"
# PERSONAL_MEMORY_OWNER_ID = "your-owner-id"
# TAVILY_BASE_URL = "https://tavily.example.com"
# Claim semantic deduplication (optional): the claims metadata indexes should
# exist before enabling filtered semantic dedup. All values below are the
# built-in defaults, so you only need to override what you want to change.
# CLAIM_DEDUP_SAME_SCORE = "0.92"
# CLAIM_DEDUP_REVIEW_MIN_SCORE = "0.75"
# CLAIM_DEDUP_TOP_K = "12"
# CLAIM_DEDUP_LLM_ENABLED = "true"
# CLAIM_DEDUP_AUTO_REPLACE = "false"
# /memory/* uses MEMORY_API_TOKEN (or API_TOKEN as fallback) plus the
# required X-Project-Id request header. ALLOWED_MEMORY_PROJECTS is recommended
# so an unknown project id fails closed instead of creating a new namespace.
# PROJECT_TOKENS_JSON and PERSONAL_MEMORY_TOKEN are migration-only credentials;
# they never select a project and should be removed after client migration.
# Extractor LLM also needs this secret:
#   EXTRACTOR_LLM_API_KEY
# Web extraction via the Tavily relay also needs secrets:
#   TAVILY_API_TOKEN  (the tavily-worker ingress token)
#   TAVILY_BASE_URL is a normal variable above, not a secret.

[triggers]
crons = ["*/5 * * * *"]
